# ── ProfileApp Caddy Configuration ──────────────────────────────────
# Automatically obtains and renews SSL/TLS certificates via Let's Encrypt / ZeroSSL.
# Set DOMAIN in your .env (e.g., DOMAIN=myprofileapp.duckdns.org).
# Defaults to localhost for local testing.

{$DOMAIN:localhost} {
    # Encode responses with gzip or zstd
    encode gzip zstd

    # Route 1: API requests -> Express Backend container
    handle /api/* {
        reverse_proxy backend:5000
    }

    # Route 2: Health check endpoint -> Express Backend container
    handle /health {
        reverse_proxy backend:5000
    }

    # Route 3: All other web traffic -> React Frontend container
    handle {
        reverse_proxy frontend:80
    }
}
