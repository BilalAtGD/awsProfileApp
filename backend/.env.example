PORT=5000
NODE_ENV=development

# ─── AWS RDS PostgreSQL (Managed by Terraform) ───────────────────
# Get DB_HOST from terraform output (`db_host`) inside terraform/ directory
DB_HOST=profileapp-db.xxxxxxxxxxxx.ap-southeast-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=profileapp
DB_USER=profileadmin
DB_PASSWORD=ProfileAppPass2026!

# ─── JWT ──────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-random-64-char-secret-key-minimum
JWT_EXPIRES_IN=7d

# ─── AWS Credentials (Named Profile or Default) ───────────────
# Set AWS_PROFILE to your AWS CLI profile name (e.g. admin-dev or default)
AWS_PROFILE=admin-dev
AWS_REGION=ap-southeast-1

# ─── AWS S3 (Managed by Terraform) ────────────────────────────
# Get S3_BUCKET_NAME from terraform output (`s3_bucket_name`)
S3_BUCKET_NAME=profileapp-pics-southeast1-v2

# ─── CORS (update after Vercel deploy) ───────────────────────
CLIENT_URL=http://localhost:5173

# ─── Google OAuth 2.0 ─────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
